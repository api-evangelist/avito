        {
          "info": {
            "name": "Превью по VIN или номеру кузова\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/autoteka/v1/previews",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает идентификатор `previewId`, по которому асинхронно с помощью [запроса на получение превью по ID](#operation/getPreview) можно получить результат\n"
        },
        {
          "info": {
            "name": "Получение превью по его ID\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/autoteka/v1/previews/:previewId",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              }
            ],
            "params": [
              {
                "name": "previewId",
                "value": "",
                "type": "path",
                "description": "Идентификатор превью"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
