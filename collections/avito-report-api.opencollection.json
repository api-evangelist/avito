          "info": {
            "name": "Синхронное создание отчета по ГРЗ\n",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/autoteka/v1/sync/create-by-regnumber",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
