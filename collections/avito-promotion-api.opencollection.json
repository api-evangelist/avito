          "info": {
            "name": "Словарь типов услуг продвижения",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/promotion/v1/items/services/dict",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Получение словаря типов услуг продвижения\n\n**Rate limit:** 100 RPM\n"
        },
