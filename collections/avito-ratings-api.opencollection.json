{
  "opencollection": "1.0.0",
  "info": {
    "name": "Иерархия Аккаунтов Access Ratings API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Ratings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Отправка ответа на отзыв",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/ratings/v1/answers",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Отправка ответа на отзыв"
        },
        {
          "info": {
            "name": "Запрос на удаление ответа на отзыв",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.avito.ru/ratings/v1/answers/:answer_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "answer_id",
                "value": "1234567",
                "type": "path",
                "description": "Идентификатор ответа на отзыв"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Запрос на удаление ответа на отзыв"
        },
        {
          "info": {
            "name": "Получение информации о рейтинге пользователя",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/ratings/v1/info",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Получение информации о рейтинге пользователя"
        },
        {
          "info": {
            "name": "Получение списка активных отзывов на пользователя с пагинацией",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/ratings/v1/reviews",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Смещение"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Лимит количества отзывов"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Получение списка активных отзывов на пользователя с пагинацией"
        }
      ]
    }
  ],
  "bundled": true
}