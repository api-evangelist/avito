        },
        {
          "info": {
            "name": "Получение аудиозаписи звонка по идентификатору",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/calltracking/v1/getRecordByCallId/",
            "params": [
              {
                "name": "callId",
                "value": "",
                "type": "query",
                "description": "Идентификатор звонка"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает запись звонка по его id (callId).\n\nМы гарантируем, что записи звонка доступны для получения в течение 3х месяцев после завершения звонка.\n\nЗаписи звонка становятся доступны в данном API с некоторой задержкой после окончания звонка. Обычно эта задержка составляет до 30 минут.\n"
        }
