            "name": "Звонки по времени",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/calltracking/v1/getCalls/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
