        {
          "id": "ab5816ce-3715-42f8-80b6-711cf9e9af00",
          "name": "Получение аудиозаписи звонка по идентификатору",
          "request": {
            "name": "Получение аудиозаписи звонка по идентификатору",
            "description": {
              "content": "Возвращает запись звонка по его id (callId).\n\nМы гарантируем, что записи звонка доступны для получения в течение 3х месяцев после завершения звонка.\n\nЗаписи звонка становятся доступны в данном API с некоторой задержкой после окончания звонка. Обычно эта задержка составляет до 30 минут.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "calltracking",
                "v1",
                "getRecordByCallId",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "callId",
                  "value": "<integer>",
                  "description": "(Required) Идентификатор звонка"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.avito.ru/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
