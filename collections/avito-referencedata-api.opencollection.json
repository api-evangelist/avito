{
  "opencollection": "1.0.0",
  "info": {
    "name": "Иерархия Аккаунтов Access ReferenceData API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "ReferenceData",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Запрос остатка отчётов пользователя\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/autoteka/v1/packages/active_package",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает остаток отчётов в текущем пакете пользователя\n"
        },
        {
          "info": {
            "name": "Получение списка отчётов\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/autoteka/v1/reports/list/",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              }
            ],
            "params": [
              {
                "name": "lastReportId",
                "value": "",
                "type": "query",
                "description": "Идентификатор отчета для получения данных постранично."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Количество отчетов в результате"
              },
              {
                "name": "vin",
                "value": "",
                "type": "query",
                "description": "Фильтр по VIN или номеру кузова"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Получение списка запрошенных ранее отчетов [запроса на создание отчета](#operation/postReport)\n"
        }
      ]
    }
  ],
  "bundled": true
}