                  },
                  {
                    "disabled": false,
                    "description": "(Required) Токен для авторизации",
                    "key": "Authorization",
                    "value": "Bearer ACCESS_TOKEN"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
