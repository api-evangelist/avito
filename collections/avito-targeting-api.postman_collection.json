              "id": "74f96702-2d95-453d-96ce-4a09cce62757",
              "name": "Успешный ответ",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "1",
                    "agency",
                    "clients",
                    "target",
                    "result"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
