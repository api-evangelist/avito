                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"result\": {\n    \"status\": \"success\",\n    \"items\": [\n      {\n        \"inn\": \"<string>\",\n        \"isError\": false,\n        \"results\": [\n          {\n            \"category\": \"goods\",\n            \"status\": \"new\"\n          },\n          {\n            \"category\": \"goods\",\n            \"status\": \"new\"\n          }\n        ]\n      },\n      {\n        \"inn\": \"<string>\",\n        \"isError\": false,\n        \"results\": [\n          {\n            \"category\": \"goods\",\n            \"status\": \"new\"\n          },\n          {\n            \"category\": \"goods\",\n            \"status\": \"new\"\n          }\n        ]\n      }\n    ]\n  }\n}",
