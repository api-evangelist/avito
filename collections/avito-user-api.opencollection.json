{
  "opencollection": "1.0.0",
  "info": {
    "name": "Иерархия Аккаунтов Access User API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Получение истории операций пользователя",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/core/v1/accounts/operations_history/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает список операций пользователя (списания/пополнение кошелька - деньги и бонусы) за определенный временной период (задается пользователем)\n"
        },
        {
          "info": {
            "name": "Получение информации об авторизованном пользователе",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/core/v1/accounts/self",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает идентификатор пользователя и его регистрационные данные\n"
        },
        {
          "info": {
            "name": "Получение баланса кошелька пользователя",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/core/v1/accounts/:user_id/balance/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "Идентификатор пользователя (клиента)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Возвращает сумму реальных денежных средств в кошельке, а также сумму бонусных средств\n"
        }
      ]
    }
  ],
  "bundled": true
}