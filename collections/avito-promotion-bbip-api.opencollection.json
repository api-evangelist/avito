            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avito.ru/promotion/v1/items/services/bbip/forecasts/get",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer ACCESS_TOKEN"
              },
              {
