{
  "opencollection": "1.0.0",
  "info": {
    "name": "Иерархия Аккаунтов Access GetAhInfoV1 API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "GetAhInfoV1",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Получение полной информации о статусе пользователя в ИА",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avito.ru/getAhInfoV1",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Oauth-Scopes",
                "value": "ah:access"
              },
              {
                "name": "X-Oauth-Flow",
                "value": "authorization_code"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://avito.ru/oauth",
              "accessTokenUrl": "https://api.avito.ru/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Ручка для получения информации по ИА для пользователя. Если запрос делается от имени сотрудника, то будет возвращён список компаний, которым он принадлежит.\n"
        }
      ]
    }
  ],
  "bundled": true
}