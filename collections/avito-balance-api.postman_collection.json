              "body": "{\n  \"items\": [\n    {\n      \"transactionId\": \"b52717c26fbc027acc34f165490fd4fdf404f3aa\",\n      \"operationDateTime\": \"2025-05-02T11:00:00+03:00\",\n      \"amount\": 100000,\n      \"status\": \"success\",\n      \"clientId\": 123456\n    },\n    {\n      \"transactionId\": \"b52717c26fbc027acc34f165490fd4fdf404f3aa\",\n      \"operationDateTime\": \"2025-05-02T11:00:00+03:00\",\n      \"amount\": 100000,\n      \"status\": \"success\",\n      \"clientId\": 123456\n    }\n  ]\n}",
