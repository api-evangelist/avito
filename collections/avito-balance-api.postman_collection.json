                  "raw": "{\n  \"dateFrom\": \"2025-05-02T11:00:00+03:00\",\n  \"dateTo\": \"2025-05-02T11:00:00+03:00\",\n  \"limit\": 100,\n  \"offset\": 10\n}",
                  "options": {
