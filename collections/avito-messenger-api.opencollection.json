            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "Идентификатор пользователя (клиента)"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "uploadfile[]",
                  "type": "text",
                  "value": ""
                }
