                  "key": "accessTokenUrl",
                  "value": "https://api.avito.ru/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stocks\": [\n    {\n      \"item_id\": \"<long>\",\n      \"quantity\": \"<long>\",\n      \"external_id\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
