              ],
              "body": "{\n  \"status\": \"ok\",\n  \"result\": {\n    \"total\": 123,\n    \"clients\": [\n      {\n        \"clientId\": 123456,\n        \"name\": \"Клиент\",\n        \"status\": \"active\",\n        \"linkType\": \"adv\",\n        \"linkTime\": \"2025-05-02T11:00:00+03:00\",\n        \"advance\": {\n          \"amount\": 100000\n        },\n        \"balance\": {\n          \"amount\": 100000\n        },\n        \"mainUserId\": 123456,\n        \"statistics\": {\n          \"activeItems\": 123,\n          \"spendings\": 100000,\n          \"views\": 123,\n          \"clicks\": 123\n        },\n        \"subscription\": {\n          \"category\": \"goods\",\n          \"level\": \"maximal\",\n          \"isActive\": true,\n          \"expiredTo\": \"2025-05-02T11:00:00+03:00\"\n        }\n      },\n      {\n        \"clientId\": 123456,\n        \"name\": \"Клиент\",\n        \"status\": \"active\",\n        \"linkType\": \"adv\",\n        \"linkTime\": \"2025-05-02T11:00:00+03:00\",\n        \"advance\": {\n          \"amount\": 100000\n        },\n        \"balance\": {\n          \"amount\": 100000\n        },\n        \"mainUserId\": 123456,\n        \"statistics\": {\n          \"activeItems\": 123,\n          \"spendings\": 100000,\n          \"views\": 123,\n          \"clicks\": 123\n        },\n        \"subscription\": {\n          \"category\": \"goods\",\n          \"level\": \"maximal\",\n          \"isActive\": true,\n          \"expiredTo\": \"2025-05-02T11:00:00+03:00\"\n        }\n      }\n    ]\n  }\n}",
